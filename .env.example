# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public base URL used in magic-link redirects (Vercel sets VERCEL_URL automatically)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Event shown on the home page
NEXT_PUBLIC_DEFAULT_EVENT_SLUG=southport-christmas-2026

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Needed by the notification worker to read and update queued notifications.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends this as a bearer token to /api/cron/notifications.
CRON_SECRET=
# Email delivery through Resend (optional; messages stay queued without it).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="Southport Christmas Parade <parade@yourdomain.com>"
# SMS delivery through Twilio (optional; SMS falls back to email without it).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
